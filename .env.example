# Copy to .env.local for local development. Never commit real values.

# Anthropic (research)
ANTHROPIC_API_KEY=

# Stripe (payments; Stripe is the only system of record)
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=
# Price of one report in SGD cents (4900 = S$49.00)
REPORT_PRICE_SGD_CENTS=4900

# Cloudflare Turnstile. These are Cloudflare's public "always passes" test keys; replace in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# HMAC secret for signed tokens (scan tickets, preview tokens, report signatures). 32+ random chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REPORT_SIGNING_SECRET=

# ---- Individual Legal Screen ----
# Separate HMAC secret for person-screen input hashes, report signatures and verification codes. 32+ random chars.
REPORT_HMAC_SECRET=
# Model for the person-screen research. Must support web_search_20260209 (Sonnet 5.5 / Opus 5.5).
CLAUDE_MODEL=claude-sonnet-5-5
# Price of one screen in SGD cents (2900 = S$29.00). Leave blank to switch the person screen off.
PERSON_SCREEN_PRICE_SGD_CENTS=2900
# Shown on the failure page as a "Request a refund" mailto link.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Emailing the PDF to the buyer (optional: leave blank to skip emails).
# The sender must be on a domain verified in Resend, e.g. "Reports <reports@yourdomain.com>".
# For testing, "onboarding@resend.dev" works but only delivers to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
